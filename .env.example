# ---------------------------------------------------------------------------
# Portal de Onboarding y Aprovisionamiento de Hefesto Studio
# ---------------------------------------------------------------------------
#
# Plantilla de configuración. NO tiene ningún valor real y no debe recibir ninguno.
# Copiala a .env y completa los valores en el servidor, nunca en el repositorio.
#
# Sobre la credencial de Coolify: es lo más delicado de este archivo. Da acceso a toda
# la plataforma de despliegue de Hefesto. Antes de escribirla aquí, lee
# docs/05-SEGURIDAD.md.

# --- Aplicación -----------------------------------------------------------
APP_NOMBRE="Portal de Onboarding de Hefesto"
APP_VERSION="0.1.0"
APP_ENV=produccion
APP_DEBUG=false
# Generar con: docker compose -f deploy/compose.produccion.yaml run --rm api php artisan key:generate
APP_KEY=
APP_URL=https://onboarding.hefesto.cl

# --- Base de datos --------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=portal_onboarding
DB_USERNAME=portal
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=portal_onboarding_admin
DB_ADMIN_PASSWORD=

DB_SSLMODE=prefer

# --- Redis (caché, sesiones y colas) --------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
COOKIE_URL_BASE=https://onboarding.hefesto.cl

# --- Integración con Coolify ----------------------------------------------
# La base es la instancia seguida de /api/v1, según la documentación oficial.
# Verificado el 17-10-2026 en https://coolify.io/docs/api/overview
COOLIFY_URL_BASE=https://coolify.ejemplo.cl/api/v1

# Token de Hefesto. Habilidades solicitadas: lectura y escritura.
# NO pedir "despliegue", ni "lectura sensible", ni "root".
# La credencial completa tiene el formato identificador|secreto y se envía tal cual.
COOLIFY_TOKEN=

# Interruptor general. Con false, el flujo se recorre completo y NO se llama a Coolify.
COOLIFY_HABILITADA=false

# Despliegue automático: fase posterior, requiere credencial propia.
COOLIFY_PERMITIR_DESPLIEGUE=false
COOLIFY_TOKEN_DESPLIEGUE=

# Servidor donde se crean los servicios de los clientes.
COOLIFY_SERVIDOR_UUID=
COOLIFY_ENTORNO=production

# Direcciones desde las que Coolify aceptará peticiones. La restricción se configura en
# Coolify; aquí queda la lista para poder auditarla.
COOLIFY_IP_PERMITIDAS=

COOLIFY_TIMEOUT=20
COOLIFY_REINTENTOS=2
COOLIFY_ESPERA_REINTENTOS=3

# --- Integración con Infisical (entrega de credenciales) -------------------
# Estado: DESHABILITADA. La ruta exacta de creación de secretos no se pudo verificar
# contra la documentación pública. Antes de habilitarla, confirmar la ruta en
# https://<instancia>/api/docs/json y poner INFISICAL_RUTA_VERIFICADA=true.
INFISICAL_URL_BASE=https://infisical.ejemplo.cl/api
INFISICAL_TOKEN=
INFISICAL_HABILITADA=false
INFISICAL_RUTA_VERIFICADA=false
INFISICAL_RUTA_CREAR_SECRETO=/v3/secrets
INFISICAL_PROYECTO=
INFISICAL_ENTORNO=production
INFISICAL_CARPETA_RAIZ=clientes
INFISICAL_TIMEOUT=15

# --- Notificaciones por ntfy ----------------------------------------------
# El tema es una contraseña: se genera al azar por empresa y no se elige a mano.
NTFY_URL=https://ntfy.sh
NTFY_HABILITADO=false
NTFY_TIMEOUT=10
NTFY_PRIORIDAD=default

# --- Comportamiento del portal -------------------------------------------
MODO_APROVISIONAMIENTO=deshabilitado
# Con false, quien crea una solicitud no puede aprobarla: otra persona de Hefesto
# tiene que revisarla.
PERMITIR_AUTOAPROBACION=false

# --- Identidad: Authentik (OIDC) ---------------------------------------------
# La identidad la trae Authentik, igual que en las otras aplicaciones de Hefesto.
# El portal NO guarda contraseñas.
#
# Rutas verificadas contra la documentación oficial el 17-10-2026:
#   Autorización   /application/o/authorize/
#   Token          /application/o/token/
#   Usuario        /application/o/userinfo/
# Solo el fin de sesión y las claves públicas llevan el identificador de la
# aplicación: /application/o/<slug>/end-session/ y /application/o/<slug>/jwks/.
AUTHENTIK_URL=https://id.ejemplo.cl
AUTHENTIK_SLUG=portal-onboarding
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Debe coincidir exactamente con una de las direcciones registradas en el proveedor.
AUTHENTIK_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Correos del personal de Hefesto: los únicos que entran al área de aprobación.
AUTHENTIK_CORREOS_HFESTO=
# Dominios del personal de Hefesto. Más cómodo, pero más ancho: cualquier cuenta del
# dominio entra al área de aprobación.
AUTHENTIK_DOMINIOS_HFESTO=
AUTHENTIK_GRUPO_APROBADORES=hefesto-aprobadores
AUTHENTIK_TIMEOUT=15

# --- Frontend -------------------------------------------------------------
NUXT_API_BASE=http://api:9000